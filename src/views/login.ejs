<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TicketZen - Register</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="../public/css/login_register.css" />
    <link
            href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500&family=Lora:wght@600;700&display=swap"
            rel="stylesheet"
    />
</head>
<body>
<div class="register-container">
    <a href="#" class="logo" aria-label="TicketZen Home">
        <img src="../public/images/logo.svg" width="160" height="50" alt="TicketZen - Home">
    </a>
    <form action="/register/" method="post" id="registerForm">
        <label for="username">Full name:</label>
        <input type="text" id="username" name="username" required />

        <label for="password">Password:</label>
        <input
                type="password"
                id="password"
                name="password"
                required
                aria-describedby="PasswordHelp"
        />
        <button type="submit" class="btn btn-divider rounded-pill">
            Login
        </button>
    </form>
    <p>
        Create an account
        <a href="/register" class="text-accent">Register here</a>
    </p>
</div>

<script>
    // JavaScript to handle password confirmation
    document.getElementById("registerForm").addEventListener("submit", function(event) {
        const password = document.getElementById("password").value;
        const confirmPassword = document.getElementById("confirm-password").value;
        const confirmPasswordHelp = document.getElementById("confirmPasswordHelp");

        if (password !== confirmPassword) {
            confirmPasswordHelp.textContent = "Passwords do not match!";
            confirmPasswordHelp.style.color = "red";
            event.preventDefault(); // Prevent form submission
        } else {
            confirmPasswordHelp.textContent = ""; // Clear message if passwords match
        }
    });
</script>
</body>
</html>
