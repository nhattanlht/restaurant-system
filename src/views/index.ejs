<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head')%>
</head>

<body id="top">
<!--#PRELOADER-->
<div class="preload" data-preaload>
  <div class="circle"></div>
  <p class="text">Grilli</p>
</div>

<!--#TOP BAR-->
<div class="topbar"><%-include('partials/topbar')%></div>

<!--#HEADER-->
<header class="header" data-header><%-include('partials/header')%></header>

<main>
  <article>
    <!--#HERO-->
    <section class="hero text-center" aria-label="home" id="home"><%-include('pages/hero')%></section>

    <!--#SERVICE-->
    <section class="section service bg-black-10 text-center" aria-label="service"><%-include('pages/service')%></section>

    <!--#ABOUT-->
    <section class="section about text-center" aria-labelledby="about-label" id="about"><%-include('pages/about')%></section>

    <!--#SPECIAL DISH-->
    <section class="special-dish text-center" aria-labelledby="dish-label"><%-include('pages/specialDish')%></section>

    <!--#MENU-->
    <section class="section menu" aria-label="menu-label" id="menu"><%-include('pages/menu')%></section>

    <!--#TESTIMONIALS-->
    <section class="section testi text-center has-bg-image"><%-include('pages/testimontials')%></section>


    <!--#RESERVATION-->
    <section class="reservation"><%-include('pages/reservation')%></section>

    <!--#FEATURES-->
    <section class="section features text-center" aria-label="features"><%-include('pages/features')%></section>

    <!--#EVENT-->
    <section class="section event bg-black-10" aria-label="event"><%-include('pages/event')%></section>

  </article>
</main>

<!--#FOOTER-->
<footer class="footer section has-bg-image text-center"<%-include('partials/footer')%>></footer>

<!--#BACK TO TOP-->
<a href="#top" class="back-top-btn active" aria-label="back to top" data-back-top-btn>
  <ion-icon name="chevron-up" aria-hidden="true"></ion-icon>
</a>

<!--custom js link-->
<script src="../public/js/script.js"></script>

<!--ionicon link-->
<script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>

</body>

</html>