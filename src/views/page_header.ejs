<!-- Page header start -->
<head>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Poppins&display=swap" rel="stylesheet" />
    
    <!-- Custom CSS -->
    <link href="/css/main.css" rel="stylesheet" />
    <link href="/css/cart.css" rel="stylesheet" />

    <!-- Font Awesome CDN for icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />
    
    <!-- Title can be dynamically set -->
    <title><%= title || 'Default Title' %></title>
</head>
<body>
  
    <div class="header">
        <img class="logo" src="../public/images/logo.svg" alt="logo">
        <div class="header-right">
            <div class="action-cart">
                <a href="/cart" class="shopping-bag-button">
                <img class="shopping-bag" src="/images/shopping-bag.png" alt="shopping-bag">
                <span class="count-holder">0</span>
                </a>
            </div>
            <a class="button" href="#">Login/Signup</a>
        </div>
    </div>

    <!-- Banner with overlay and small banner -->
    <div class="banner">
        <img src="../public/images/banner.png" alt="banner">
    </div>   
