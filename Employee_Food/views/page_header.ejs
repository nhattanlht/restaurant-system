<!-- Page header start -->

<head>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Poppins&display=swap" rel="stylesheet" />

    <!-- Custom CSS -->
    <link href="/css/main.css" rel="stylesheet" />
    <link href="/css/cart.css" rel="stylesheet" />

    <!-- Title can be dynamically set -->
    <title>
        <%= title || 'Default Title' %>
    </title>
</head>

<body>
    <div class="header">
        <img class="logo" src="/images/logo.svg" alt="logo">
        <div class="header-right">
            <div class="action-cart">
                <a onclick="showcart()" class="shopping-bag-button">
                <img class="shopping-bag" src="/images/shopping-bag.png" alt="shopping-bag">
                <span class="count-holder">0</span>
                </a>
            </div>
            <a class="button" href="#">Login/Signup</a>
        </div>
    </div>

    <!-- Shopping cart -->
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Giỏ Hàng</h5>
            <span class="close">&times;</span>
        </div>
        <div class="modal-body">
            <div class="cart-row">
                
            </div>
            <div class="cart-total">
                <strong class="cart-total-title">Tổng Cộng:</strong>
                <span class="cart-total-price">0VNĐ</span>
            </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-secondary close-footer">Đóng</button>
            <button type="button" class="btn btn-primary order">Thanh Toán</button>
        </div>
    </div>
    </div>
    <!-- Banner with overlay and small banner -->
    <div class="banner">
        <img src="/images/banner.png" alt="banner">
    </div>
</body>
<!-- page header end -->